  function escapeSoftHolidayText_(value) {
    return String(value || '').replace(/[&<>"']/g, function(character) {
      return {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;'
      }[character];
    });
  }

  function softHolidayBadgesHtml_(warnings) {
    var html = '';
    warnings = warnings || [];

    for (var i = 0; i < warnings.length; i++) {
      html +=
        '<span class="badge badge-info">' +
        'Soft Holiday: ' +
        escapeSoftHolidayText_(warnings[i]) +
        '</span>';
    }

    return html;
  }

  function appendPublicSoftHolidayBadges_(container, warnings) {
    warnings = warnings || [];

    for (var i = 0; i < warnings.length; i++) {
      var badge = document.createElement('span');
      badge.className = 'badge badge-info';
      badge.textContent = 'Soft Holiday: ' + warnings[i];
      container.appendChild(badge);
    }
  }
